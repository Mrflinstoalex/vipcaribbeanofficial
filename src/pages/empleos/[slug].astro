---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import EmpleoDetalle from "@/components/pages/EmpleoDetalle";
import { getEmpleoBySlug } from "@/lib/cms";

const { slug } = Astro.params;
if (!slug) {
  throw new Error("Missing slug parameter");
}

let empleo: any = null;
let error: string | null = null;

try {
  empleo = await getEmpleoBySlug(slug);
} catch (e) {
  console.error(`Error cargando empleo con slug "${slug}":`, e);
  error = 'No se pudo cargar la vacante en este momento. Por favor, intenta más tarde.';
}

const pageTitle = empleo?.titulo ? `${empleo.titulo} | VIP Caribbean` : undefined;
const pageDesc  = empleo?.descripcion
  ? (empleo.descripcion as string).replace(/<[^>]*>/g, "").slice(0, 160).trim()
  : undefined;
---

<Layout title={pageTitle} description={pageDesc}>
  <EmpleoDetalle empleo={empleo} error={error} slug={slug} client:load />
</Layout>